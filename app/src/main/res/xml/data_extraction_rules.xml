<?xml version="1.0" encoding="utf-8"?>
<!--
  The server login in audiobookshelf/account.json stays out of the cloud backup. Moving to a new phone takes it along.
  So do the covers from the files, as Voice gets them from there again, and a cloud backup over 25 MB doesn't run at
  all.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="file" path="audiobookshelf/account.json" />
    <exclude domain="file" path="bookCovers" />
  </cloud-backup>
</data-extraction-rules>
