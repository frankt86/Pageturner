<?xml version="1.0" encoding="utf-8"?>
<!--
  The server login in audiobookshelf/account.json stays out of the backup. The covers from the files stay out too, as
  Voice gets them from there again, and a backup over 25 MB doesn't run at all.
-->
<full-backup-content>
  <exclude domain="file" path="audiobookshelf/account.json" />
  <exclude domain="file" path="bookCovers" />
</full-backup-content>
