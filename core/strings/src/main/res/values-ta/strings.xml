    <string name="audiobookshelf.login.credentials.no_password">இந்த சர்வர் ஒற்றை உள்நுழைவை (SSO) மட்டுமே அனுமதிக்கிறது, அதை Pageturner இன்னும் ஆதரிக்கவில்லை. கடவுச்சொல் மூலம் உள்நுழைவதை இயக்குமாறு சர்வரை நிர்வகிப்பவரிடம் கேளுங்கள்.</string>
    <string name="audiobookshelf.login.credentials.subtitle">%s இல் உள்ள உங்கள் கணக்கைப் பயன்படுத்தவும்.</string>
