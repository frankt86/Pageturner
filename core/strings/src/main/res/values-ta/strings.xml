    <string name="audiobookshelf.login.address.label">சர்வர் முகவரி</string>
    <string name="audiobookshelf.login.address.subtitle">உங்கள் சொந்த சர்வரில் உள்ள புத்தகங்களைக் கேளுங்கள். நீங்கள் கேட்ட இடத்தை உங்கள் மற்ற சாதனங்களுடன் Pageturner ஒத்திசைவில் வைத்திருக்கும்.</string>
